# Gemini API key (https://aistudio.google.com/apikey). Leave it unset to run without AI:
# questions then come from the built-in question bank and answers get simple local scoring.
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-3.8-flash
# Optional. Empty = database/cognihire.db. Or use sqlite:///path/to/file.db
DATABASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
